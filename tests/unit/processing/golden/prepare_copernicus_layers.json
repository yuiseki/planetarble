      "<tmp>/tmp/copernicus_vrts/true_color/14_14552_6452.vrt"
    ]
  ],
  [
    "build Copernicus mosaic VRT",
    [
      "gdalbuildvrt",
      "-resolution",
      "highest",
      "-input_file_list",
      "<tmp>/tmp/copernicus_vrts/true_color/inputs.txt",
      "<tmp>/tmp/copernicus_true_color_mosaic.vrt"
    ]
  ],
  [
    "convert Copernicus mosaic to COG",
    [
      "gdal_translate",
      "-of",
      "COG",
      "-co",
      "COMPRESS=JPEG",
      "-co",
      "BLOCKSIZE=512",
      "-co",
      "NUM_THREADS=ALL_CPUS",
      "<tmp>/tmp/copernicus_true_color_mosaic.vrt",
      "<tmp>/output/processing/copernicus_true_color_cog.tif",
      "-co",
      "QUALITY=90"
    ]
  ]
]
