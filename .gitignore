.env

# Local operator notes (host-specific, not version-controlled)
AGENTS_MEMO.md
configs/base/STORAGE_RELOCATION_*.md

# Local data workspaces (not version-controlled)
# Both forms are needed: trailing-slash patterns do not match symlinks.
data/
tmp/
output/
configs/base/data/
configs/base/tmp/
configs/base/output/
configs/base/data
configs/base/tmp
configs/base/output
# A profile run in place writes beside itself; keep that out of git too.
configs/profiles/data
configs/profiles/tmp
configs/profiles/output
# ...but the package's own data (e.g. ocean/depth_ramp.json, loaded via
# importlib.resources as planetarble.data) must be committed.
!src/planetarble/data/

# Local scratch configs (official recipes live in configs/profiles/)
configs/base/pipeline-*.yaml

# Stray rasters that land directly in configs/base/ (e.g. interrupted OAM/COG
# fragments); never commit imagery here.
configs/base/*.tif
configs/base/*.tif_*
configs/base/*.tiff

# Python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
ENV/

.coverage
