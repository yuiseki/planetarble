[
  [
    "normalize BMNG raster",
    [
      "gdal_translate",
      "-of",
      "GTiff",
      "-a_srs",
      "EPSG:4326",
      "-co",
      "TILED=YES",
      "-co",
      "COMPRESS=DEFLATE",
      "<tmp>/bmng_mosaic.tif",
      "<tmp>/output/processing/bmng_mosaic_normalized.tif"
    ]
  ]
]
